import { SpotifyGqlApi } from '../../dependencies/hetu_spotify_gql_client/lib/assets/hetu/spotify_gql_api_client.ht'
import { Converters } from '../converter/converter.ht'

class PlaylistEndpoint {
  var client: SpotifyGqlApi

  construct (this.client)

  fun getPlaylist(id: string) {
    if (id == null || id.isEmpty) {
      return null
    }

    return client.playlist.getPlaylist(id).then((data) {
      if (data == null) {
        return null
      }
      var converted = Converters.fullPlaylists([data])
      return converted.isNotEmpty ? converted[0] : null
    })
  }

  fun tracks(id: string, { offset: int, limit: int }) {
    if (id == null || id.isEmpty) {
      return {
        limit: limit ?? 20,
        nextOffset: null,
        hasMore: false,
        total: 0,
        items: []
      }.toJson()
    }

    return client.playlist.tracks(id, offset: offset, limit: limit).then((data) {
      if (data == null) {
        return {
          limit: limit ?? 20,
          nextOffset: null,
          hasMore: false,
          total: 0,
          items: []
        }.toJson()
      }

      // Extract track objects from playlist items (they're wrapped with metadata)
      var trackItems = (data["items"] ?? [])
        .where((item) => item != null && item["track"] != null)
        .map((item) => item["track"])
        .toList()

      // Create modified data with extracted tracks for pagination
      var modifiedData = {
        items: trackItems,
        total: data["total"] ?? trackItems.length,
        offset: data["offset"] ?? offset ?? 0,
        limit: data["limit"] ?? limit ?? 20
      }

      var paginated = Converters.paginated(
        modifiedData,
        (items) => Converters.fullTracks(items)
      )

      // Spotify playlists can contain local tracks which do not have an ID and cannot be played
      // We filter them out here to avoid issues in the client
      paginated["items"] = paginated["items"]
        .where((item) => item != null && item["id"] != null)
        .toList()

      return paginated
    })
  }

  fun create(userId: string, {
    name: string,
    description: string,
    public: bool,
    collaborative: bool
  }) {
    if (userId == null || userId.isEmpty || name == null || name.isEmpty) {
      return null
    }

    return client.playlist.create(
      userId,
      name: name,
      description: description ?? "",
      public: public ?? true,
      collaborative: collaborative ?? false
    ).then((data) {
      if (data == null) {
        return null
      }
      var converted = Converters.fullPlaylists([data])
      return converted.isNotEmpty ? converted[0] : null
    })
  }

  fun update(playlistId: string, {
    name: string,
    description: string,
    public: bool,
    collaborative: bool
  }) {
    if (playlistId == null || playlistId.isEmpty) {
      return false
    }

    return client.playlist.update(
      playlistId,
      name: name,
      description: description,
      public: public,
      collaborative: collaborative
    ).then(() => true)
  }

  fun deletePlaylist(playlistId: string) {
    return this.unsave(playlistId)
  }

  fun addTracks(playlistId: string, { trackIds: List, position: int }) {
    if (playlistId == null || playlistId.isEmpty || trackIds == null || trackIds.isEmpty) {
      return false
    }

    return client.playlist.addTracks(
      playlistId,
      uris: trackIds.map((id) => "spotify:track:${id}").toList(),
      position: position
    ).then(() => true)
  }

  fun removeTracks(playlistId: string, { trackIds: List }) {
    if (playlistId == null || playlistId.isEmpty || trackIds == null || trackIds.isEmpty) {
      return false
    }

    return client.playlist.removeTracks(
      playlistId,
      uris: trackIds.map((id) => "spotify:track:${id}").toList()
    ).then(() => true)
  }

  fun save(playlistId: string) {
    if (playlistId == null || playlistId.isEmpty) {
      return false
    }
    return client.playlist.follow(playlistId).then(() => true)
  }

  fun unsave(playlistId: string) {
    if (playlistId == null || playlistId.isEmpty) {
      return false
    }
    return client.playlist.unfollow(playlistId).then(() => true)
  }
}

export { PlaylistEndpoint }
